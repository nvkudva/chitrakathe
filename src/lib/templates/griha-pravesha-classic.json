{
  "id": "griha-pravesha-classic",
  "version": 1,
  "occasion": "griha_pravesha",
  "region": "Pan-India",
  "name": {
    "kn": "ಗೃಹ ಪ್ರವೇಶ — ಶಾಸ್ತ್ರೀಯ",
    "kok": "गृह प्रवेश — पारंपारीक",
    "hi": "गृह प्रवेश — शास्त्रीय",
    "en": "Housewarming — Classic"
  },
  "blurb": {
    "kn": "ಮನೆಯೇ ನಾಯಕ. ಮನೆಯ ಫೋಟೋಗಳು ಸಾಮಾನ್ಯವಾಗಿ ಸಪ್ಪೆ, ಹಾಗಾಗಿ ಅಕ್ಷರಗಳೇ ಭಾರ ಹೊರುತ್ತವೆ.",
    "kok": "घरूच नायक. घराचीं फोटयां चडशीं बरीं येनात, देखून अक्षरांच वजें व्हरतात.",
    "hi": "घर ही नायक है। घर की तस्वीरें अक्सर फीकी होती हैं, इसलिए अक्षर भार उठाते हैं।",
    "en": "The house is the protagonist. Photos of houses are usually flat, so the typography carries it."
  },
  "defaultScript": {
    "kn": "kannada",
    "kok": "devanagari",
    "hi": "devanagari",
    "en": "latin"
  },
  "photosRequired": {
    "min": 6,
    "max": 10
  },
  "music": "nadaswaram-soft",
