# ---- core ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chitrakathe
APP_URL=http://localhost:3000
# NODE_ENV is set by the runtime. Never pin it here: `next build` with
# NODE_ENV=development resolves the development React and the prerender fails.

# ---- object storage: "local" | "s3" ----
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- video model: primary then secondary, comma separated ----
# Available: fal | replicate | stub
VIDEO_PROVIDERS=stub,stub
VIDEO_MODEL_PRIMARY=fal-ai/bytedance/seedance/v1/lite/image-to-video
VIDEO_MODEL_SECONDARY=wan-video/wan-2.5-i2v
FAL_KEY=
REPLICATE_API_TOKEN=

# ---- tts: sarvam | elevenlabs | stub ----
TTS_PROVIDER=stub
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# ---- moderation: sightengine | stub ----
MODERATION_PROVIDER=stub
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# ---- payments ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- economics (paise, integers) ----
PRICE_LAUNCH_PAISE=49900
PRICE_RERENDER_PAISE=14900
COST_CEILING_PAISE=9500
USD_INR_RATE=89

# ---- binaries ----
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# ---- retention ----
ASSET_RETENTION_DAYS=30
OUTPUT_RETENTION_DAYS=90

# Signs local-driver upload/download URLs. Generate a random value in production.
SIGNING_SECRET=dev-only-signing-secret
ADMIN_TOKEN=
